# WellBoard UCI config.
# Section 'main' is read by /etc/init.d/wellboard at start time.

config wellboard 'main'
	# Enable the service (0 = init script does nothing).
	option enabled '1'
	# Web UI / API listen port (WELLBOARD_PORT for the binary).
	option port '8090'
	# Listen address for the web UI (NFR-2.1). Unset (recommended):
	# the binary binds the br-lan interface IP (LAN only). Set to an
	# IP ('192.168.1.1') or an interface name ('br-lan') to pin it.
	# Empty value ('') = all interfaces, including WAN — not
	# recommended without firewall rules and authentication.
	#option bind 'br-lan'
	# State directory (HWID, subscriptions, profiles, logs).
	# Listed in /lib/upgrade/keep.d/wellboard: survives sysupgrade.
	option state_dir '/etc/wellboard'
	# Template catalog shipped with the package.
	option templates_dir '/usr/share/wellboard/templates'
