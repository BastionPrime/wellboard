# Build / test artifacts (anchored: must not match the cmd/wellboard package dir)
/wellboard
/cmd/wellboard/wellboard

# Dev-mode mihomo binary fetched by scripts/fetch-mihomo.sh (never commit)
/bin/

# MetaCubeXD dist fetched by scripts/fetch-metacubexd.sh into ui/ —
# ~8 MB of third-party build artifacts, NOT vendored (DECISIONS D18).
/ui/metacubexd/

# Go module / cache pollution (docker builds mount the repo)
go.sum.bak
gocache/
*.log
coverage.cov

# Frontend (web/): node_modules and Vite caches are never committed.
# dist/ IS committed (DECISIONS D13: embedded into the Go binary).
/web/node_modules/
/web/.vite/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Cross-compile outputs (Phase 6) and local package builds.
# Anchored to the repo root: the SPA bundle in web/dist is COMMITTED
# (DECISIONS D13) — an unanchored `dist/` also matched web/dist and
# silently dropped the hashed JS bundles from commits (fixed 2026-09).
.build/
/dist/

# Staged prebuilt binaries for the OpenWrt package build (Phase 6 matrix
# leaves the cross-compiled binary here; never commit it)
/packaging/openwrt/prebuilt/
