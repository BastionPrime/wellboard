# Build / test artifacts (anchored: must not match the cmd/wellboard package dir)
/wellboard
/cmd/wellboard/wellboard

# Dev-mode mihomo binary fetched by scripts/fetch-mihomo.sh (never commit)
/bin/

# Go module / cache pollution (docker builds mount the repo)
go.sum.bak
gocache/
*.log
coverage.cov

# Frontend (web/): node_modules and Vite caches are never committed.
# dist/ IS committed (DECISIONS D13: embedded into the Go binary).
/web/node_modules/
/web/.vite/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
